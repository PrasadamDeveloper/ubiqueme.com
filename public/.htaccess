<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Asegura que FollowSymLinks esté habilitado (necesario en LiteSpeed/cPanel)
  Options +FollowSymLinks
  
  # Si el archivo o directorio solicitado existe, sírvelo directamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Redirige todo lo demás a index.html (SPA)
  RewriteRule . /index.html [L]
</IfModule>

# Si mod_rewrite no está disponible, muestra un error 404 personalizado
FallbackResource /index.html

# Cache busting para archivos estáticos con hash
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>